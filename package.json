{
  "name": "@lumyx/ui",
  "version": "0.3.0",
  "description": "The Lumyx design system: React components and Tailwind CSS v4 tokens.",
  "license": "MIT",
  "author": "Mathieu Chambaud",
  "homepage": "https://github.com/lumyx-dev/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumyx-dev/ui.git"
  },
  "bugs": {
    "url": "https://github.com/lumyx-dev/ui/issues"
  },
  "keywords": [
    "lumyx",
    "design-system",
    "react",
    "tailwindcss",
    "shadcn"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./code-theme": {
      "types": "./src/code-theme.d.ts",
      "default": "./src/code-theme.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "verify:ds": "node scripts/verify-ds.mjs",
    "preversion": "test \"$(git branch --show-current)\" = main && git fetch -q origin main && test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/main)\" && bun run check-types && bun test && bun run verify:ds && npm pack --dry-run",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.0.2"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
